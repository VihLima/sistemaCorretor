DATABASE_URL="postgresql://corretor:corretor@localhost:5432/corretor"
# conexões por instância no pool do pg (opcional, padrão 5)
DATABASE_POOL_MAX="5"
TEST_DATABASE_URL="postgresql://corretor:corretor@localhost:5432/corretor_test"
APP_URL="http://localhost:3000"
# local | supabase  (tests force "memory")
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="property-images"
# Opt-ins (deixe vazios): ALLOW_SEED=1 permite o seed fora de banco local;
# ALLOW_LOCAL_STORAGE=1 permite STORAGE_DRIVER=local com NODE_ENV=production (só o e2e usa)
ALLOW_SEED=""
ALLOW_LOCAL_STORAGE=""
